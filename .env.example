# ==============================================================================
# StoryVault Environment Configuration Template
# Copy this file to '.env' and fill in your actual local configuration.
# DO NOT commit real secrets, private tokens, or credentials to version control.
# ==============================================================================

# Application Environment (e.g., development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI / LLM Provider Configuration (Placeholders only)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection & Token Pricing (Module 3.14: illustrative rates per 1k tokens in USD)
CHAT_MODEL=gpt-4o-mini
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
TOKEN_ENCODING_NAME=cl100k_base
INPUT_PRICE_PER_1K=0.00015
OUTPUT_PRICE_PER_1K=0.00060

# Vector Database & Storage Parameters (for future RAG modules)
VECTOR_DB_DIR=./data/chromadb
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
