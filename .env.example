# ==============================================================================
# StoryVault Environment Configuration Template
# Copy this file to '.env' and fill in your actual local configuration.
# DO NOT commit real secrets, private tokens, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Full-Stack Web Application (Node.js, Express, Prisma, Vite)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 18 with Full-Text Search and Vector Storage)
# Local User-space PostgreSQL default:
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/storyvault?schema=public"

# Authentication & Security Baselines
JWT_SECRET="replace-with-a-random-secret-at-least-8-characters"
JWT_EXPIRES_IN="7d"

# Gemini AI Configuration (backend-only; never expose this key to the browser)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
STORYVAULT_API_URL=http://localhost:5000
# Optional: authenticated StoryVault JWT for the standalone Python prompt tools.
STORYVAULT_API_TOKEN=""

# Vector & Ingestion Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# Python Educational Workspace Modules (Kalvium Modules 3.10 - 3.14)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
TOKEN_ENCODING_NAME=cl100k_base
INPUT_PRICE_PER_1K=0.00015
OUTPUT_PRICE_PER_1K=0.00060
VECTOR_DB_DIR=./data/chromadb
