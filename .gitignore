# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Ensure .env.example is tracked
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Project Directories & Data
# Ignore generated outputs and local documents while preserving structure
outputs/*
!outputs/.gitkeep

data/*
!data/.gitkeep

# Logs
*.log
logs/
